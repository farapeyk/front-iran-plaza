# Local development only. Never put backend credentials behind NEXT_PUBLIC_.
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
# Optional primary write endpoint. The foreign read-only region sets this to
# the Iran backend over the private VPN; reads still use BACKEND_INTERNAL_URL.
BACKEND_WRITE_URL=
SITE_URL=http://localhost:3001
# Replace with the same private development value used by the backend.
JWT_ACCESS_SECRET=replace-with-shared-development-secret
# Explicit trusted HTTPS payment-provider origins, separated by commas.
PAYMENT_ALLOWED_ORIGINS=
# Enable the private design showroom only during local review.
DESIGN_REVIEW_ENABLED=false

# Public analytics identifiers. Leave empty to keep each provider disabled.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Public ownership tokens copied from the corresponding webmaster consoles.
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
