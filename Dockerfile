# syntax=docker/dockerfile:1.7

FROM node:24.18.0-alpine AS dependencies

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder

ARG SITE_URL
ARG NEXT_PUBLIC_GA4_MEASUREMENT_ID
ARG NEXT_PUBLIC_CLARITY_PROJECT_ID
ARG NEXT_PUBLIC_YANDEX_SITE_VERIFICATION
ARG NEXT_PUBLIC_BAIDU_SITE_VERIFICATION
ENV SITE_URL=$SITE_URL
ENV NEXT_PUBLIC_GA4_MEASUREMENT_ID=$NEXT_PUBLIC_GA4_MEASUREMENT_ID
ENV NEXT_PUBLIC_CLARITY_PROJECT_ID=$NEXT_PUBLIC_CLARITY_PROJECT_ID
ENV NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=$NEXT_PUBLIC_YANDEX_SITE_VERIFICATION
ENV NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=$NEXT_PUBLIC_BAIDU_SITE_VERIFICATION
ENV NEXT_TELEMETRY_DISABLED=1

COPY . .
RUN pnpm run build

FROM node:24.18.0-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

USER node

EXPOSE 3000

CMD ["node", "server.js"]
